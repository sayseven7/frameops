# Development-only placeholders. Replace locally; never commit a populated .env file.
FRAMEOPS_POSTGRES_USER=frameops_dev
FRAMEOPS_POSTGRES_PASSWORD=replace-with-local-development-password
FRAMEOPS_POSTGRES_DB=frameops_dev
FRAMEOPS_POSTGRES_PORT=5432
FRAMEOPS_MINIO_ROOT_USER=frameops_minio_dev
FRAMEOPS_MINIO_ROOT_PASSWORD=replace-with-local-development-minio-password
FRAMEOPS_MINIO_PORT=9000
# Evidence object storage. A real deployment uses a dedicated key with access to
# this bucket only, never the object-storage root credential used locally.
FRAMEOPS_EVIDENCE_S3_ENDPOINT=http://127.0.0.1:9000
FRAMEOPS_EVIDENCE_S3_BUCKET=frameops-evidence
FRAMEOPS_EVIDENCE_S3_REGION=us-east-1
FRAMEOPS_EVIDENCE_S3_ACCESS_KEY=frameops_minio_dev
FRAMEOPS_EVIDENCE_S3_SECRET_KEY=replace-with-local-development-minio-password
# Required compliance retention for immutable persisted bytes; deployments must
# set this to their approved retention period rather than relying on a default.
FRAMEOPS_OBJECT_RETENTION_DAYS=365
