FROM golang:1.26.5-alpine@sha256:0178a641fbb4858c5f1b48e34bdaabe0350a330a1b1149aabd498d0699ff5fb2 AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -ldflags='-s -w' -o /out/frameops-api ./cmd/frameops-api && \
    CGO_ENABLED=0 go build -trimpath -ldflags='-s -w' -o /out/frameops-migrate ./cmd/frameops-migrate && \
    CGO_ENABLED=0 go build -trimpath -ldflags='-s -w' -o /out/frameops-render ./cmd/frameops-render

FROM alpine:3.23.3@sha256:25109184c71bdad752c8312a8623239686a9a2071e8825f20acb8f2198c3f659 AS api
COPY --from=build /out/frameops-api /frameops-api
COPY --from=build /out/frameops-render /frameops-render
USER 10001:10001
ENTRYPOINT ["/frameops-api"]

FROM alpine:3.23.3@sha256:25109184c71bdad752c8312a8623239686a9a2071e8825f20acb8f2198c3f659 AS migrate
COPY --from=build /out/frameops-migrate /frameops-migrate
COPY migrations /app/migrations
WORKDIR /app
USER 10001:10001
ENTRYPOINT ["/frameops-migrate"]
